{
  "name": "parabrisas-catamarca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && concurrently -k -n css,app -c yellow,cyan \"npm:dev:css\" \"npm:dev:app\"",
    "dev:css": "tailwindcss -i src/web/estilos.css -o public/css/app.css --watch",
    "dev:app": "tsx watch --clear-screen=false src/server.ts",
    "build": "prisma generate && npm run build:css && node scripts/build.mjs",
    "build:css": "tailwindcss -i src/web/estilos.css -o public/css/app.css --minify",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:migrar-caracteristicas": "tsx prisma/migrar-caracteristicas.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.50.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
