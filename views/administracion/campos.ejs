<%
  const { base, textoEspecial } = MODULOS[modulo];
  const ANCLA_LISTA = { marcas: 'marcas', tipos: 'tipos', ubicaciones: 'ubicaciones' };
  function tipoDe(c) {
    if (c.especial) return esc(textoEspecial);
    if (c.lista === 'lado') return 'Lista fija (No aplica, Izquierdo, Derecho)';
    if (c.lista) return `Lista · <a href="${base}/listas#${ANCLA_LISTA[c.lista]}" class="font-medium text-acento underline">ver opciones</a>`;
    if (c.tipo === 'LISTA') {
      const activas = c.opciones.filter((o) => o.activo).length;
      return `Lista · ${activas} ${activas === 1 ? 'opción activa' : 'opciones activas'}`;
    }
    return esc(`${ETIQUETA_TIPO[c.tipo]}${c.unidad ? ` (${c.unidad})` : ''}`);
  }
  const etiquetas = (c) => insignia(c.origen === 'PROPIO' ? 'marca' : 'neutro', c.origen === 'PROPIO' ? 'Propio' : 'Sistema')
    + (c.fijo ? insignia('neutro', 'Fijo') : c.protegido ? insignia('neutro', 'Protegido') : '');
  function acciones(c) {
    if (c.fijo) return '<span class="block text-right text-xs text-texto-suave">—</span>';
    const mover = (direccion, nombreIcono, etiqueta) => botonAccion({
      accion: `${base}/campos/${encodeURIComponent(c.clave)}/mover`, campos: { direccion }, texto: '', variante: 'fantasma', chico: true,
      etiquetaAccesible: etiqueta, html: icono(nombreIcono, 'size-3.5') });
    return `<div class="flex justify-end gap-1">${mover('ARRIBA', 'ArrowUp', 'Subir')}${mover('ABAJO', 'ArrowDown', 'Bajar')}${
      enlaceBoton({ href: `${base}/campos/${encodeURIComponent(c.clave)}`, texto: 'Editar', icono: 'Pencil', chico: true })}</div>`;
  }
%>
<%- include('_cabecera') %>

<div class="flex justify-end">
  <%- enlaceBoton({ href: `${base}/campos/nuevo`, texto: 'Nuevo campo', variante: 'primario', icono: 'Plus' }) %>
</div>

<%# Celular: una tarjeta por campo, sin scroll horizontal. %>
<div class="space-y-5 lg:hidden">
  <% for (const s of SECCIONES) { const deSeccion = campos.filter((c) => c.seccion === s.id); if (deSeccion.length === 0) continue; %>
    <section class="space-y-2">
      <h2 class="text-xs font-semibold tracking-widest text-texto-suave uppercase"><%= s.etiqueta %></h2>
      <ul class="space-y-2">
        <% for (const c of deSeccion) { %>
          <li class="<%= ui.tarjeta %> space-y-3 p-4 <%= c.visible ? '' : 'opacity-60' %>">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="font-semibold"><%= c.etiqueta %></p>
                <p class="mt-0.5 text-xs text-texto-suave"><%- tipoDe(c) %></p>
              </div>
              <div class="flex shrink-0 flex-wrap justify-end gap-1">
                <%- etiquetas(c) %>
                <%- c.archivado ? insignia('alerta', 'Archivado') : !c.visible ? insignia('alerta', 'Oculto') : '' %>
              </div>
            </div>
            <div class="flex items-center justify-between gap-3 border-t border-borde pt-3 text-xs text-texto-suave">
              <span><%= c.soloLectura || c.especial ? '' : c.requerido ? 'Obligatorio' : 'Opcional' %></span>
              <%- acciones(c) %>
            </div>
          </li>
        <% } %>
      </ul>
    </section>
  <% } %>
</div>

<div class="<%= ui.tarjeta %> hidden overflow-x-auto lg:block">
  <table class="w-full min-w-[860px] text-sm">
    <thead class="border-b border-borde text-left text-xs text-texto-suave uppercase">
      <tr>
        <th class="px-4 py-2 font-semibold">Campo</th>
        <th class="px-4 py-2 font-semibold">Tipo</th>
        <th class="px-4 py-2 font-semibold">Origen</th>
        <th class="px-4 py-2 font-semibold">Obligatorio</th>
        <th class="px-4 py-2 font-semibold">Estado</th>
        <th class="px-4 py-2 text-right font-semibold">Acciones</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-borde">
      <% for (const s of SECCIONES) { const deSeccion = campos.filter((c) => c.seccion === s.id); if (deSeccion.length === 0) continue; %>
        <tr class="bg-grafito-500/10">
          <th colspan="6" class="px-4 py-1.5 text-left text-xs font-semibold tracking-wide text-texto-suave uppercase"><%= s.etiqueta %></th>
        </tr>
        <% for (const c of deSeccion) { %>
          <tr id="c-<%= c.clave %>" class="<%= c.visible ? '' : 'opacity-60' %>">
            <td class="px-4 py-2.5">
              <p class="font-medium"><%= c.etiqueta %></p>
              <% if (c.ayuda) { %><p class="text-xs text-texto-suave"><%= c.ayuda %></p><% } %>
            </td>
            <td class="px-4 py-2.5 text-texto-suave"><%- tipoDe(c) %></td>
            <td class="px-4 py-2.5"><div class="flex flex-wrap gap-1"><%- etiquetas(c) %></div></td>
            <td class="px-4 py-2.5"><%= c.soloLectura || c.especial ? '—' : c.requerido ? 'Sí' : 'No' %></td>
            <td class="px-4 py-2.5"><%- c.archivado ? insignia('alerta', 'Archivado') : c.visible ? 'Visible' : insignia('alerta', 'Oculto') %></td>
            <td class="px-4 py-2.5"><%- acciones(c) %></td>
          </tr>
        <% } %>
      <% } %>
    </tbody>
  </table>
</div>
