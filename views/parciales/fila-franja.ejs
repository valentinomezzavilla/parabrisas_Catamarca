<div class="flex flex-col" data-fila>
  <div class="flex items-center gap-1 rounded-lg border px-2 py-1 <%= falla ? 'border-peligro' : 'border-borde' %>">
    <input type="hidden" name="franja_dia" value="<%= dia %>" data-campo="dia">
    <input type="time" name="franja_desde" value="<%= desde %>" aria-label="<%= DIAS_LARGOS[dia] %> desde" class="bg-transparent text-sm" data-campo="desde">
    <span class="text-texto-suave">–</span>
    <input type="time" name="franja_hasta" value="<%= hasta %>" aria-label="<%= DIAS_LARGOS[dia] %> hasta" class="bg-transparent text-sm" data-campo="hasta">
    <button type="button" data-quitar aria-label="Quitar franja" class="-my-1 flex size-9 items-center justify-center rounded-md text-texto-suave transition-colors hover:bg-peligro/10 hover:text-peligro"><%- icono('X', 'size-3.5') %></button>
  </div>
  <% if (falla) { %><span role="alert" class="text-xs text-peligro"><%= falla %></span><% } %>
</div>
