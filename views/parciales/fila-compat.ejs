<div class="space-y-1" data-fila>
  <div class="grid grid-cols-2 gap-2 sm:grid-cols-[2fr_1fr_1fr_2fr_auto]">
    <%- control({ nombre: 'compat_modeloId', tipo: 'select', valor: fila.modeloId, clase: `${ui.input} col-span-2 sm:col-span-1`,
                  atributos: { id: undefined, 'aria-label': 'Modelo' },
                  opciones: [{ valor: '', texto: 'Elegir modelo…' }],
                  grupos: catalogos.marcasVehiculo.map((m) => ({ etiqueta: m.nombre, opciones: m.modelos.map((mo) => ({ valor: mo.id, texto: `${m.nombre} ${mo.nombre}` })) })) }) %>
    <input type="number" name="compat_anioDesde" value="<%= fila.anioDesde %>" placeholder="Desde" aria-label="Año desde" class="<%= ui.input %>">
    <input type="number" name="compat_anioHasta" value="<%= fila.anioHasta %>" placeholder="Hasta" aria-label="Año hasta" class="<%= ui.input %>">
    <input name="compat_carroceria" value="<%= fila.carroceria %>" placeholder="Carrocería / versión" aria-label="Carrocería o versión" class="<%= ui.input %>">
    <button type="button" data-quitar aria-label="Quitar vehículo" class="<%= ui.boton.fantasma %> <%= ui.boton.chico %>"><%- icono('X') %></button>
  </div>
  <% if (falla) { %><p class="text-xs text-peligro"><%= falla %></p><% } %>
</div>
