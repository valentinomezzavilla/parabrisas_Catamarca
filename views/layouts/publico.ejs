<!doctype html>
<html lang="es-AR">
<head><%- include('../parciales/head') %></head>
<body class="min-h-dvh antialiased">
  <div class="flex min-h-dvh flex-col">
    <header class="fondo-cristal relative overflow-hidden border-b-4 border-marca">
      <div class="mx-auto flex max-w-3xl items-center gap-4 px-4 py-6 sm:gap-6 sm:py-9">
        <a href="/reservar" aria-label="Parabrisas Catamarca, inicio de reservas"
           class="shrink-0 rounded-2xl bg-white/5 p-3 ring-1 ring-white/10 transition-transform duration-300 hover:scale-105">
          <img src="/brand/logo-amarillo.png" alt="Parabrisas Catamarca" width="96" height="68" class="h-14 w-auto sm:h-[4.5rem]">
        </a>
        <div class="min-w-0">
          <p class="font-display text-2xl leading-none font-extrabold tracking-tight text-marca uppercase sm:text-4xl">Sacá tu turno</p>
          <p class="mt-2 max-w-md text-sm text-grafito-300 sm:text-base">Elegí el servicio, el día y el horario que te quede cómodo.</p>
        </div>
      </div>
    </header>
    <main class="entrada mx-auto w-full max-w-3xl flex-1 space-y-6 px-4 py-8 sm:py-10">
      <%- include('../parciales/aviso-global') %>
      <%- contenido %>
    </main>
    <footer class="border-t-4 border-marca bg-grafito-900 py-8 text-center">
      <img src="/brand/logo-amarillo.png" alt="" width="48" height="34" class="mx-auto h-8 w-auto">
      <p class="mt-2 text-xs font-medium tracking-[0.18em] text-grafito-400 uppercase">Parabrisas Catamarca</p>
    </footer>
  </div>
</body>
</html>
