<!doctype html>
<html lang="es-AR">
<head><%- include('../parciales/head') %></head>
<body class="min-h-dvh antialiased">
  <div class="flex min-h-dvh flex-col">
    <header class="border-b-4 border-marca bg-grafito-900">
      <div class="mx-auto flex max-w-3xl items-center gap-4 px-4 py-5">
        <a href="/reservar" aria-label="Parabrisas Catamarca, inicio de reservas">
          <img src="/brand/logo-amarillo.png" alt="Parabrisas Catamarca" width="96" height="68" class="h-16 w-auto">
        </a>
        <div>
          <p class="font-display text-xl font-extrabold text-marca uppercase">Sacá tu turno</p>
          <p class="text-sm text-grafito-300">Elegí el servicio, el día y el horario que te quede cómodo.</p>
        </div>
      </div>
    </header>
    <main class="mx-auto w-full max-w-3xl flex-1 space-y-6 px-4 py-8">
      <%- include('../parciales/aviso-global') %>
      <%- contenido %>
    </main>
    <footer class="border-t border-borde py-6 text-center text-xs text-texto-suave">Parabrisas Catamarca</footer>
  </div>
</body>
</html>
