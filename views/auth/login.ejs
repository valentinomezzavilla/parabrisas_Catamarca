<form method="post" action="/login" novalidate class="space-y-4">
  <h1 class="font-display text-2xl font-extrabold">Ingresar</h1>

  <% if (mensaje) { %>
    <p role="alert" class="rounded-lg border border-peligro/40 bg-peligro/10 px-3 py-2 text-sm text-peligro"><%= mensaje %></p>
  <% } %>

  <%- campo({ nombre: 'usuario', etiqueta: 'Usuario', valor: usuarioIngresado, error: errores.usuario,
              atributos: { autocapitalize: 'none', spellcheck: 'false', autocomplete: 'username', autofocus: true, required: true } }) %>
  <%- campo({ nombre: 'password', etiqueta: 'Contraseña', tipo: 'password', error: errores.password,
              atributos: { autocomplete: 'current-password', required: true } }) %>

  <button type="submit" data-enviando="Ingresando…" class="<%= ui.boton.primario %> w-full py-3 text-base">Ingresar</button>
</form>
