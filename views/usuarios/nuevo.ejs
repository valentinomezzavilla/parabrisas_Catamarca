<%- volver('/usuarios', 'Usuarios') %>
<%- encabezado({ seccion: 'Usuarios', titulo: 'Nuevo usuario' }) %>

<form method="post" action="/usuarios/nuevo" novalidate class="<%= ui.tarjeta %> max-w-xl space-y-4 p-6">
  <% if (mensaje) { %><%- aviso('peligro', mensaje) %><% } %>
  <%- campo({ nombre: 'nombre', etiqueta: 'Nombre', valor: valores.nombre, error: errores.nombre, atributos: { autocomplete: 'off' } }) %>
  <%- campo({ nombre: 'usuario', etiqueta: 'Usuario', valor: valores.usuario, error: errores.usuario,
              ayuda: 'Con el que va a ingresar. Letras, números y . _ @ - (sin espacios).',
              atributos: { autocapitalize: 'none', spellcheck: 'false', autocomplete: 'off' } }) %>
  <%- campo({ nombre: 'password', etiqueta: 'Contraseña', tipo: 'password', error: errores.password,
              ayuda: 'Mínimo 5 caracteres, sin otras reglas. Se la pasás vos a la persona.', atributos: { autocomplete: 'new-password' } }) %>
  <%- campo({ nombre: 'rol', etiqueta: 'Rol', tipo: 'select', valor: valores.rol, error: errores.rol,
              ayuda: 'Admin gestiona usuarios y servicios. Empleado maneja turnos y stock.',
              opciones: [{ valor: 'EMPLEADO', texto: 'Empleado' }, { valor: 'ADMIN', texto: 'Administrador' }] }) %>
  <div class="flex justify-end gap-2">
    <%- enlaceBoton({ href: '/usuarios', texto: 'Cancelar' }) %>
    <button type="submit" data-enviando="Guardando…" class="<%= ui.boton.primario %>">Crear usuario</button>
  </div>
</form>
