<%- encabezado({
  seccion: 'Inventario',
  titulo: 'Stock de cristales',
  descripcion: `${plural(cristales.length, 'artículo', 'artículos')} · ${plural(unidades, 'unidad', 'unidades')}${hayFiltros ? ' (filtrado)' : ''}`,
  acciones: enlaceBoton({ href: '/stock/nuevo', texto: 'Nuevo cristal', variante: 'primario', icono: 'Plus' }),
}) %>

<form method="get" action="/stock" class="<%= ui.tarjeta %> space-y-3 p-3 sm:p-4">
  <div class="flex gap-2">
    <input name="texto" value="<%= f.texto ?? '' %>" placeholder="Código o descripción" aria-label="Buscar por código o descripción" class="<%= ui.input %>">
    <button class="<%= ui.boton.primario %> shrink-0" aria-label="Buscar"><%- icono('Search') %> <span class="hidden sm:inline">Buscar</span></button>
  </div>

  <%# En celular los filtros avanzados se pliegan detrás de un botón; desde `md` se muestran siempre. %>
  <button type="button" data-plegar aria-expanded="<%= filtrosAvanzados > 0 %>" aria-controls="filtros-avanzados"
          class="flex min-h-11 w-full items-center justify-between gap-2 rounded-lg border border-borde px-3 text-sm font-semibold md:hidden">
    <span class="flex items-center gap-2">
      <%- icono('SlidersHorizontal') %> Filtros
      <% if (filtrosAvanzados > 0) { %><span class="rounded-full bg-marca px-2 py-0.5 text-xs text-sobre-marca"><%= filtrosAvanzados %></span><% } %>
    </span>
    <span data-flecha class="transition-transform <%= filtrosAvanzados > 0 ? 'rotate-180' : '' %>"><%- icono('ChevronDown') %></span>
  </button>
  <div id="filtros-avanzados" class="<%= filtrosAvanzados > 0 ? 'grid' : 'hidden' %> gap-3 md:grid md:grid-cols-2 lg:grid-cols-4">
    <%- control({ nombre: 'modeloId', tipo: 'select', valor: f.modeloId ?? '', atributos: { 'aria-label': 'Vehículo' },
                  opciones: [{ valor: '', texto: 'Cualquier vehículo' }],
                  grupos: catalogos.marcasVehiculo.map((m) => ({ etiqueta: m.nombre, opciones: m.modelos.map((mo) => ({ valor: mo.id, texto: `${m.nombre} ${mo.nombre}` })) })) }) %>
    <%- control({ nombre: 'anio', tipo: 'number', valor: f.anio ?? '', atributos: { placeholder: 'Año', 'aria-label': 'Año del vehículo' } }) %>
    <%- control({ nombre: 'ubicacionId', tipo: 'select', valor: f.ubicacionId ?? '', atributos: { 'aria-label': 'Ubicación' },
                  opciones: [{ valor: '', texto: 'Toda ubicación' }, ...catalogos.ubicaciones.map((u) => ({ valor: u.id, texto: u.nombre }))] }) %>
    <%- control({ nombre: 'tipoId', tipo: 'select', valor: f.tipoId ?? '', atributos: { 'aria-label': 'Tipo' },
                  opciones: [{ valor: '', texto: 'Todo tipo' }, ...catalogos.tipos.map((t) => ({ valor: t.id, texto: t.nombre }))] }) %>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm md:col-span-2 lg:col-span-3">
      <label class="flex min-h-9 items-center gap-2">
        <input type="checkbox" name="stock" value="1"<% if (f.stock === '1') { %> checked<% } %> class="size-5 accent-amarillo-500"> Solo con stock
      </label>
      <label class="flex min-h-9 items-center gap-2">
        <input type="checkbox" name="bajas" value="1"<% if (f.bajas === '1') { %> checked<% } %> class="size-5 accent-amarillo-500"> Incluir dados de baja
      </label>
    </div>
    <div class="flex gap-2 md:justify-end">
      <% if (hayFiltros) { %><%- enlaceBoton({ href: '/stock', texto: 'Limpiar', variante: 'fantasma' }) %><% } %>
      <button class="<%= ui.boton.secundario %> flex-1 md:flex-none"><%- icono('Search') %> Aplicar</button>
    </div>
  </div>
</form>

<% if (cristales.length === 0) { %>
  <%- vacio(hayFiltros ? 'No hay cristales que coincidan con la búsqueda.' : 'Todavía no hay cristales cargados.', 'Package') %>
<% } else { %>
  <%# Celular: una tarjeta por cristal, sin scroll horizontal. %>
  <ul class="space-y-3 lg:hidden">
    <% for (const c of cristales) { const bajo = c.cantidad <= c.stockMinimo; %>
      <li>
        <a href="/stock/<%= c.id %>" class="<%= ui.tarjeta %> block p-4 active:bg-grafito-500/5 <%= c.activo ? '' : 'opacity-60' %>">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-mono text-xs font-semibold text-acento"><%= c.codigo %></p>
              <p class="mt-0.5 font-semibold leading-snug"><%= c.descripcion %></p>
              <p class="mt-0.5 text-xs text-texto-suave"><%= c.marca.nombre %> · <%= c.tipo.nombre %><%= c.activo ? '' : ' · dado de baja' %></p>
            </div>
            <%- insignia(c.cantidad === 0 ? 'peligro' : bajo ? 'alerta' : 'exito', `${c.cantidad} u.`) %>
          </div>
          <div class="mt-3 flex items-end justify-between gap-3 border-t border-borde pt-3 text-xs text-texto-suave">
            <span><%= c.ubicacion.nombre %> <%= NOMBRE_LADO[c.lado] %><br><%= medidas(c.anchoMm, c.altoMm, c.espesorMm) %></span>
            <span class="font-display text-base font-bold text-texto tabular-nums"><%= pesos(c.precioVenta) %></span>
          </div>
        </a>
      </li>
    <% } %>
  </ul>

  <div class="<%= ui.tarjeta %> hidden overflow-x-auto lg:block">
    <table class="w-full min-w-[760px] text-sm">
      <thead class="border-b border-borde bg-grafito-500/5 text-left text-xs tracking-wide text-texto-suave uppercase">
        <tr>
          <th class="px-4 py-3 font-semibold">Código</th>
          <th class="px-4 py-3 font-semibold">Descripción</th>
          <th class="px-4 py-3 font-semibold">Ubicación</th>
          <th class="px-4 py-3 font-semibold">Medidas</th>
          <th class="px-4 py-3 text-right font-semibold">Precio</th>
          <th class="px-4 py-3 text-right font-semibold">Stock</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-borde">
        <% for (const c of cristales) { const bajo = c.cantidad <= c.stockMinimo; %>
          <tr class="transition-colors hover:bg-marca/5 <%= c.activo ? '' : 'opacity-50' %>">
            <td class="px-4 py-3 font-mono text-xs"><a href="/stock/<%= c.id %>" class="font-semibold hover:text-acento"><%= c.codigo %></a></td>
            <td class="px-4 py-3">
              <a href="/stock/<%= c.id %>" class="hover:underline"><%= c.descripcion %></a>
              <p class="text-xs text-texto-suave"><%= c.marca.nombre %> · <%= c.tipo.nombre %><%= c.activo ? '' : ' · dado de baja' %></p>
            </td>
            <td class="px-4 py-3"><%= c.ubicacion.nombre %> <%= NOMBRE_LADO[c.lado] %></td>
            <td class="px-4 py-3 text-texto-suave"><%= medidas(c.anchoMm, c.altoMm, c.espesorMm) %></td>
            <td class="px-4 py-3 text-right tabular-nums"><%= pesos(c.precioVenta) %></td>
            <td class="px-4 py-3 text-right"><%- insignia(c.cantidad === 0 ? 'peligro' : bajo ? 'alerta' : 'exito', String(c.cantidad)) %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>
