<%
  const bajo = c.cantidad <= c.stockMinimo;
  const TIPO_MOVIMIENTO = { INGRESO: 'Ingreso', EGRESO: 'Egreso', AJUSTE: 'Ajuste' };
  const AYUDA = {
    INGRESO: 'Compra a proveedor o devolución.',
    EGRESO: 'Venta o colocación.',
    AJUSTE: 'Corrección por conteo: usá un número negativo para restar (ej. -1 por rotura).',
  };
  const dato = (etiquetaDato, texto) => `<div><dt class="text-xs text-texto-suave">${esc(etiquetaDato)}</dt><dd class="font-medium">${esc(texto)}</dd></div>`;
  const acciones = enlaceBoton({ href: `/stock/${c.id}/editar`, texto: 'Editar', icono: 'Pencil' }) + (c.activo
    ? botonAccion({ accion: `/stock/${c.id}/estado`, texto: 'Dar de baja', pregunta: 'Se ocultará de búsquedas', confirmar: 'Dar de baja' })
    : botonAccion({ accion: `/stock/${c.id}/estado`, texto: 'Reactivar', campos: { activo: 'on' } }));
%>
<%- volver('/stock', 'Stock') %>
<%- encabezado({
  seccion: c.codigo,
  titulo: c.descripcion,
  descripcion: `${c.marca.nombre} · ${c.tipo.nombre} · ${c.ubicacion.nombre} ${visible('lado') ? NOMBRE_LADO[c.lado] : ''}`.trim(),
  acciones,
}) %>
<% if (!c.activo) { %><%- aviso('alerta', 'Este cristal está dado de baja: no aparece en las búsquedas.') %><% } %>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
  <div class="min-w-0 space-y-6">
    <section class="<%= ui.tarjeta %> p-5 text-center">
      <p class="text-sm text-texto-suave">Stock disponible</p>
      <p class="font-display text-6xl font-extrabold tabular-nums <%= c.cantidad === 0 ? 'text-peligro' : bajo ? 'text-alerta' : '' %>"><%= c.cantidad %></p>
      <p class="mt-1 text-xs text-texto-suave">Mínimo <%= c.stockMinimo %><% if (bajo) { %> · <span class="font-semibold text-alerta">reponer</span><% } %></p>
    </section>

    <section class="<%= ui.tarjeta %> p-5">
      <dl class="grid grid-cols-2 gap-4 text-sm">
        <% if (visible('anchoMm') || visible('altoMm') || visible('espesorMm')) { %>
          <%- dato('Medidas', medidas(visible('anchoMm') ? c.anchoMm : null, visible('altoMm') ? c.altoMm : null, visible('espesorMm') ? c.espesorMm : null)) %>
        <% } %>
        <% if (visible('ubicacionDeposito')) { %><%- dato(etiqueta('ubicacionDeposito'), c.ubicacionDeposito ?? '—') %><% } %>
        <% if (visible('costo')) { %><%- dato(etiqueta('costo'), pesos(c.costo)) %><% } %>
        <% if (visible('precioVenta')) { %><%- dato(etiqueta('precioVenta'), pesos(c.precioVenta)) %><% } %>
        <% if (visible('codigoFabricante')) { %><%- dato(etiqueta('codigoFabricante'), c.codigoFabricante ?? '—') %><% } %>
        <% for (const a of adicionales) { %><%- dato(a.etiqueta, a.texto) %><% } %>
      </dl>
    </section>

    <% if (visible('compatibilidades')) { %>
      <section class="<%= ui.tarjeta %> p-5">
        <h2 class="mb-3 font-display font-bold"><%= etiqueta('compatibilidades') %></h2>
        <% if (c.compatibilidades.length === 0) { %>
          <p class="text-sm text-texto-suave">Sin vehículos cargados.</p>
        <% } else { %>
          <ul class="space-y-1.5 text-sm">
            <% for (const comp of c.compatibilidades) { %>
              <li>
                <span class="font-medium"><%= comp.modelo.marca.nombre %> <%= comp.modelo.nombre %></span>
                <span class="text-texto-suave"><%= comp.anioDesde ?? '…' %>–<%= comp.anioHasta ?? 'actual' %><%= comp.carroceria ? ` · ${comp.carroceria}` : '' %></span>
              </li>
            <% } %>
          </ul>
        <% } %>
      </section>
    <% } %>
  </div>

  <div class="min-w-0 space-y-6">
    <section id="movimiento" class="<%= ui.tarjeta %> scroll-mt-4 p-5">
      <h2 class="mb-4 font-display font-bold">Registrar movimiento</h2>
      <form method="post" action="/stock/<%= c.id %>/movimientos#movimiento" class="space-y-4" novalidate>
        <%- include('../parciales/aviso-en', { ancla: 'movimiento' }) %>
        <% if (movimiento.mensaje) { %><%- aviso('peligro', movimiento.mensaje) %><% } %>
        <div class="grid gap-4 sm:grid-cols-[1fr_1fr_2fr]">
          <%- campo({ nombre: 'tipo', etiqueta: 'Tipo', tipo: 'select', valor: movimiento.valores.tipo, error: movimiento.errores.tipo, atributos: { 'data-ayuda': 'ayuda-movimiento' },
                      opciones: Object.entries(TIPO_MOVIMIENTO).map(([valor, texto]) => ({ valor, texto, datos: { ayuda: AYUDA[valor] } })) }) %>
          <%- campo({ nombre: 'cantidad', etiqueta: 'Cantidad', tipo: 'number', valor: movimiento.valores.cantidad, error: movimiento.errores.cantidad, atributos: { step: 1 } }) %>
          <%- campo({ nombre: 'motivo', etiqueta: 'Motivo (opcional)', valor: movimiento.valores.motivo, error: movimiento.errores.motivo, atributos: { placeholder: 'Remito 0001-2345, venta mostrador…' } }) %>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p id="ayuda-movimiento" class="text-xs text-texto-suave"><%= AYUDA[movimiento.valores.tipo] ?? AYUDA.INGRESO %></p>
          <button type="submit" data-enviando="Registrando…" class="<%= ui.boton.primario %>">Registrar movimiento</button>
        </div>
      </form>
    </section>

    <section class="<%= ui.tarjeta %> overflow-hidden">
      <h2 class="px-5 pt-5 pb-3 font-display font-bold">Historial</h2>
      <% if (c.movimientos.length === 0) { %>
        <p class="px-5 pb-5 text-sm text-texto-suave">Sin movimientos.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[480px] text-sm">
            <thead class="border-y border-borde text-left text-xs text-texto-suave uppercase">
              <tr>
                <th class="px-5 py-2 font-semibold">Fecha</th>
                <th class="px-5 py-2 font-semibold">Tipo</th>
                <th class="px-5 py-2 font-semibold">Motivo</th>
                <th class="px-5 py-2 text-right font-semibold">Cant.</th>
                <th class="px-5 py-2 text-right font-semibold">Saldo</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-borde">
              <% for (const m of c.movimientos) { %>
                <tr>
                  <td class="px-5 py-2 whitespace-nowrap text-texto-suave"><%= fechaHora(m.creadoEn) %></td>
                  <td class="px-5 py-2"><%= TIPO_MOVIMIENTO[m.tipo] %></td>
                  <td class="px-5 py-2"><%= m.motivo ?? (m.turno ? 'Turno de colocación' : '—') %></td>
                  <td class="px-5 py-2 text-right font-semibold tabular-nums <%= m.cantidad > 0 ? 'text-exito' : 'text-peligro' %>"><%= m.cantidad > 0 ? `+${m.cantidad}` : m.cantidad %></td>
                  <td class="px-5 py-2 text-right tabular-nums"><%= m.saldo %></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </div>
</div>
