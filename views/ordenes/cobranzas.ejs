<%- volver('/ordenes', 'Órdenes') %>
<%- encabezado({
  seccion: 'Órdenes de trabajo',
  titulo: 'Cobranzas',
  descripcion: `${pesos(total)} por cobrar de trabajos instalados o facturados. Los días se cuentan desde la factura o, si no hay, desde que se recibió la orden.`,
}) %>

<% if (grupos.length === 0 && sinImporte.length === 0) { %>
  <%- vacio('No hay nada pendiente de cobro.', 'Wallet') %>
<% } %>

<% for (const g of grupos) { %>
  <section class="<%= ui.tarjeta %> overflow-hidden">
    <header class="flex flex-wrap items-end justify-between gap-3 border-b border-borde p-4 sm:p-5">
      <div>
        <h2 class="font-display text-lg font-extrabold"><%= g.nombre %></h2>
        <p class="text-sm text-texto-suave">
          <%= plural(g.ordenes.length, 'orden', 'órdenes') %> · la más vieja, <%= plural(g.masAntigua, 'día', 'días') %>
          <% if (g.masAntigua >= diasAlerta) { %><%- insignia('alerta', `más de ${diasAlerta} días`) %><% } %>
        </p>
      </div>
      <p class="font-display text-2xl font-extrabold tabular-nums text-acento"><%= pesos(g.saldo) %></p>
    </header>
    <ul class="divide-y divide-borde">
      <% for (const o of g.ordenes) { %>
        <li>
          <a href="/ordenes/<%= o.id %>#plata" class="grid grid-cols-1 gap-x-4 gap-y-1 px-4 py-3 text-sm transition-colors hover:bg-marca/5 sm:grid-cols-[5rem_minmax(0,1fr)_auto_8rem] sm:items-center sm:px-5">
            <span class="font-mono text-xs font-semibold text-acento">#<%= o.numero %></span>
            <span class="min-w-0">
              <span class="font-semibold"><%= o.patente ?? 'Sin patente' %></span>
              <span class="block truncate text-xs text-texto-suave">
                <%= o.facturaNumero ? `Factura ${o.facturaNumero}` : 'Sin facturar' %><%= o.siniestro && !/^https?:/i.test(o.siniestro) ? ` · Sin. ${o.siniestro}` : '' %>
                · cobrado <%= pesos(o.cobrado) %> de <%= pesos(o.total) %>
              </span>
            </span>
            <span class="whitespace-nowrap"><%- insignia(o.dias >= diasAlerta ? 'alerta' : 'neutro', `${plural(o.dias, 'día', 'días')}${o.desdeFactura ? '' : ' · sin factura'}`) %></span>
            <span class="font-semibold tabular-nums sm:text-right"><%= pesos(o.saldo) %></span>
          </a>
        </li>
      <% } %>
    </ul>
  </section>
<% } %>

<% if (sinImporte.length > 0) { %>
  <section class="<%= ui.tarjeta %> space-y-3 p-4 sm:p-5">
    <div>
      <h2 class="font-display font-bold">Sin importe cargado</h2>
      <p class="text-sm text-texto-suave">Están instaladas o facturadas pero no tienen el importe total: no se pueden sumar a lo que falta cobrar.</p>
    </div>
    <ul class="flex flex-wrap gap-2">
      <% for (const o of sinImporte) { %>
        <li><%- enlaceBoton({ href: `/ordenes/${o.id}#plata`, texto: `#${o.numero} · ${o.patente ?? 'sin patente'}`, chico: true }) %></li>
      <% } %>
    </ul>
  </section>
<% } %>
