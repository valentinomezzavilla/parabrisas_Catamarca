# Copiar a .env y completar con los datos del PostgreSQL local o del servidor.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parabrisas_catamarca?schema=public"

# Clave con la que se firma la cookie de sesión. Mínimo 32 caracteres.
# Generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Primer administrador. Solo los usa `npm run db:seed`, y solo si todavía no hay usuarios.
# Después del primer seed se pueden borrar de este archivo.
ADMIN_USUARIO=""
ADMIN_PASSWORD=""
ADMIN_NOMBRE="Administrador"

# Mercado Pago (cobro de la seña de los turnos).
# Credenciales en https://www.mercadopago.com.ar/developers/panel (primero las de prueba).
MP_ACCESS_TOKEN=""
# Clave secreta del webhook (Tus integraciones > Webhooks) para validar la firma de los avisos.
MP_WEBHOOK_SECRET=""
# URL pública de la app, sin barra final. Se usa para el regreso desde Mercado Pago y para el aviso por webhook.
# En desarrollo local (http://localhost:3000) Mercado Pago no puede avisar: hace falta un túnel https (ngrok, cloudflared).
APP_URL="http://localhost:3000"
